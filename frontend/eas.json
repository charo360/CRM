{
    "cli": {
        "version": ">= 14.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "node": "20.19.4",
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "node": "20.19.4",
            "distribution": "internal",
            "channel": "preview",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_BACKEND_URL": "https://crm-1-pnfo.onrender.com"
            }
        },
        "production": {
            "node": "20.19.4",
            "channel": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "EXPO_PUBLIC_BACKEND_URL": "https://crm-1-pnfo.onrender.com",
                "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_QgGKlpHwtYdpJXDHLTdCuGHqkmC"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "serviceAccountKeyPath": "./google-service-account.json",
                "track": "production"
            }
        }
    }
}

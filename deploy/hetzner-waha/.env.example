# One unique file per server. Do not put a real copy of this file in Git.
WAHA_DOMAIN=wa-1.example.com
WAHA_WORKER_ID=zilo-wa-1

# Generate this with a password manager. It is used by Zilo's backend.
WAHA_API_KEY=replace-with-a-long-random-value

# Optional global fallback egress. Zilo normally supplies a dedicated proxy
# per new session from WAHA_REGION_PROXIES_JSON in the backend environment.
# Never put real proxy credentials in this tracked example file.
# WHATSAPP_PROXY_SERVER=proxy.example.net:3128
# WHATSAPP_PROXY_SERVER_USERNAME=replace-me
# WHATSAPP_PROXY_SERVER_PASSWORD=replace-me

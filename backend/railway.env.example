# ── Copy these into Railway → Variables tab ──────────────────────────────────
# Replace all placeholder values with your real credentials

# MongoDB Atlas
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/?appName=Cluster0
DB_NAME=whatsapp_crm

# JWT — generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256

# OpenAI
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY

# Anthropic
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY

# Grok/xAI
GROK_API_KEY=REPLACE_WITH_YOUR_KEY

# DeepSeek
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_KEY

# AWS S3 (product images)
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_KEY
AWS_BUCKET_NAME=crm-images-2025
AWS_REGION=us-east-2

# ImgBB
IMGBB_API_KEY=REPLACE_WITH_YOUR_KEY

# Evolution API — set to your hosted Evolution API URL after deploying it
EVOLUTION_API_URL=https://YOUR_EVOLUTION_RAILWAY_URL
EVOLUTION_API_KEY=crm-evolution-key-2024

# Webhook base URL — set to your Railway backend URL after deploy
WEBHOOK_BASE_URL=https://YOUR_BACKEND_RAILWAY_URL

# Server URL (for media/image links in messages)
SERVER_URL=https://YOUR_BACKEND_RAILWAY_URL

# IAP (fill in when registering on stores)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_SA_KEY_PATH=
APPLE_SHARED_SECRET=
